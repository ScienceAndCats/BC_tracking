# Paths are relative to this file. Quote paths containing spaces or #.
INPUT_DIR=/home/hwilms3/Downloads/20261102_Illumina_DNA_Reads_66027474307/
OUTPUT_DIR=outputs
BARCODE_GROUPS_CSV=/home/hwilms3/Downloads/02Nov2026_96barcodes.csv
THREADS=auto

# Flank detection
UPSTREAM=TCATAGTGAGCTCAGCG
DOWNSTREAM=GTGCCCCACAAGAGGTT
MIN_MATCH=11
PROGRESS_EVERY=200000

# Barcode extraction and error collapsing
EXPECTED_BARCODE_LEN=24
MIN_BARCODE_LEN=1
MAX_BARCODE_LEN=100
INCLUDE_EMPTY_BARCODES=true
MIN_REAL_BARCODE_COUNT=3
COLLAPSE_BARCODES=true
STARCODE_PATH=starcode
STARCODE_DISTANCE=3
STARCODE_CLUSTER_RATIO=3

# Comma-separated original FASTA/FASTQ filenames in sample order; empty = alphabetical.
# Example: EXPLICIT_FILES=Initial_S254_R1_001.fastq.gz,16hr_S255_R1_001.fastq.gz
EXPLICIT_FILES=Initial_S254_R1_001.fastq.gz,16hr_S255_R1_001.fastq.gz,22hr_S256_R1_001.fastq.gz,45hr_S257_R1_001.fastq.gz,70hr_S258_R1_001.fastq.gz
USE_EXISTING_REAL_COLUMN=true
TOP_N_FOR_EACH_RANKED_OUTPUT=500

# Plots always require REAL in the FIRST sample; later real flags do not matter.
REAL_BARCODE_SAMPLE=first
MAKE_INTERACTIVE_TRAJECTORY_PLOTS=true
TOP_N_TO_PLOT=100
MAX_BARCODES_IN_HEATMAP=200
MAKE_PLOTS=true
MAKE_HEATMAPS=true
MAKE_FIRST_VS_LAST_SCATTER=true
MAKE_TOP_TRAJECTORY_PLOTS=true
MAKE_ALL_BARCODE_TRAJECTORY_PLOT=true
ALL_TRAJECTORY_MIN_COUNT_IN_ANY_SAMPLE=3
ALL_TRAJECTORY_MAX_BARCODES_TO_PLOT=5000
MAKE_GAIN_LOSS_RATIO_HEATMAP=true
GAIN_LOSS_HEATMAP_MIN_COUNT_IN_ANY_SAMPLE=3
GAIN_LOSS_HEATMAP_MAX_BARCODES=200
GAIN_LOSS_HEATMAP_SORT=last_vs_first
GAIN_LOSS_HEATMAP_SHOW_NUMBERS=true
GAIN_LOSS_HEATMAP_NUMBER_DECIMALS=1
LOG_SCALE_Y_AXIS=true
DPI=300
